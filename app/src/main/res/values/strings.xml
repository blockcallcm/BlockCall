    <string name="ob_welcome_title">Welcome to BlockCall</string>
    <string name="ob_welcome_body">Silently rejects calls from numbers you don\'t know. Setup takes less than a minute.</string>
    <string name="ob_welcome_battery">No battery drain: Android wakes it only when a call comes in</string>
    <string name="ob_welcome_offline">No internet: your contacts and history never leave your phone</string>
    <string name="ob_welcome_contacts">Your contacts can always reach you</string>
    <string name="ob_what_you_see">What you\'ll see</string>
    <string name="ob_role_title">Allow call screening</string>
    <string name="ob_role_body">It\'s the only essential permission: without it BlockCall can\'t reject calls.</string>
    <string name="ob_role_notice">“Set BlockCall as your default caller ID &amp; spam app?”\n\n1. If a list appears, select “BlockCall” (not “None”).\n2. Tap “Set as default”.</string>
    <string name="ob_role_phone">It doesn\'t replace your Phone app: you call and answer as usual</string>
    <string name="ob_role_truecaller">Only one app can screen calls. If you use Truecaller or a similar app, it will stop doing so, and you shouldn\'t give it the permission back</string>
    <string name="ob_role_retry">Android no longer shows the prompt. Tap “Open settings” and choose BlockCall under “Caller ID &amp; spam app”.</string>
    <string name="ob_role_denied">Not granted. Without this permission BlockCall can\'t block calls.</string>
    <string name="ob_contacts_title">Access to your contacts</string>
    <string name="ob_contacts_body">So the people you have saved can always get through.</string>
    <string name="ob_contacts_denied">Without this permission nothing is screened in “Contacts” mode. You can skip it and use only your Allowed list.</string>
    <string name="ob_contacts_notice">“Allow BlockCall to access your contacts?”\n\nTap “Allow”.</string>
    <string name="ob_contacts_private">BlockCall only checks whether the caller is a contact; it doesn\'t copy or send your address book</string>
    <string name="ob_notif_title">Blocked-call notice</string>
    <string name="ob_notif_body">A single silent notification, with no sound or vibration, telling you how many calls were blocked.</string>
    <string name="ob_notif_notice">“Allow BlockCall to send you notifications?”\n\nTap “Allow”.</string>
    <string name="ob_maker_title">%s setting</string>
    <string name="ob_maker_body">Your phone may prevent Android from waking BlockCall when a call comes in.</string>
    <string name="ob_how_to">What to do</string>
    <string name="ob_maker_notice">1. Tap “Open settings”.\n2. Find “Autostart”.\n3. Turn it on for BlockCall and come back here.</string>
    <string name="ob_done_title">All set!</string>
    <string name="ob_done_body">BlockCall will be on with these settings. You can change them anytime from Home.</string>
    <string name="ob_done_always">Always on (you can set a schedule, e.g. 20:00 to 06:00)</string>
    <string name="ob_done_repeat">If the same number calls twice within 3 minutes, the second call rings (useful in emergencies)</string>
    <string name="ob_done_notify">Silent notice for each blocked call</string>
    <string name="ob_done_recent">If you call a number, their call back gets through for 7 days</string>
    <string name="ob_done_missing_role">Call screening is still missing: BlockCall won\'t block anything until you grant it from Home.</string>
